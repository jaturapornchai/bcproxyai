# BCAiRouter production env — copy to .env.production on the server.
# DO NOT commit the real .env.production file.
# scripts/deploy-droplet.sh refuses to deploy while any <...> placeholder is left
# or when no auth variable is set.

# === Owner: Google login only ===
# Google account(s) allowed in — comma-separated.
AUTH_OWNER_EMAIL=owner@example.com

# Google OAuth client. Authorized redirect URI on Google Console:
#   https://<your-domain>/api/auth/callback/google
# NEXTAUTH_URL is set in docker-compose.prod.yml.
NEXTAUTH_SECRET=<generate-with-node-crypto-randomBytes-32-base64>
GOOGLE_CLIENT_ID=<from-google-console>
GOOGLE_CLIENT_SECRET=<from-google-console>

# Optional: encrypts provider API keys stored in the DB (keys are entered at /setup).
# At least 16 chars; keep it stable — keys sealed with one value cannot be read with another.
# APP_ENCRYPTION_KEY=

# Production has no master key and no password login:
# keep GATEWAY_API_KEY and ADMIN_PASSWORD unset.

# === Database (docker compose interpolates these via --env-file .env.production) ===
# Generate once: openssl rand -hex 24 — the same password goes in both lines.
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-24>
DATABASE_URL=postgres://bcai:<same-password>@postgres:5432/bcairouter  # pragma: allowlist secret (placeholder)

# === Clients ===
# /v1/* clients use bcai_live_* keys issued by the owner at /admin/keys.

# === Cost policy ===
# Hardcoded free-only: only models in src/lib/free-model-catalog.ts are called.
# Allowlist / paid-override env vars are ignored.
